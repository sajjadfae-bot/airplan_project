            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Captain Raya\",\n  \"license_number\": \"PIL-1001\",\n  \"phone\": \"09120000000\",\n  \"password\": \"secret123\",\n  \"status\": \"active\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/pilot/store",
              "host": ["{{baseUrl}}"],
              "path": ["pilot", "store"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('token', pm.response.json().token);",
                  "    console.log('token ذخیره شد');",
                  "}"
                ]
              }
            }
          ],
          "response": []
